  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\req"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\resolution"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\utils"
