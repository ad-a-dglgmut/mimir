  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip\_vendor\rich"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip\_vendor\tomli"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip\_vendor\tomli_w"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip\_vendor\truststore"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip\_vendor\urllib3"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib\python3.13\site-packages\pip-25.3.dist-info\licenses\src"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\__pycache__"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\cli"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\commands"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\distributions"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\index"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\locations"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\metadata"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\models"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_internal\network"
