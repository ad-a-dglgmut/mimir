  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\__pycache__"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\cachecontrol"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\certifi"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\dependency_groups"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\distlib"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\distro"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\idna"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\msgpack"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\packaging"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\pkg_resources"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\platformdirs"
  RMDir /REBOOTOK "$INSTDIR\python\venv\lib64\python3.13\site-packages\pip\_vendor\pygments"
