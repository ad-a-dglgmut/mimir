{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir",
  "version": "0.1.0",
  "identifier": "com.pavel.mimir",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mimir",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
"resources": [
  "keys/tauri.pub",
  "python/analyzer.py",
  "python/create-venvs.sh",
  "python/create-macos-venv.sh",
  "python/create-macos-venv-venvpack.sh",
  "python/create-venvs.ps1",
  "python/create-windows-python.ps1"
]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNkVCRkVGRDJGNTQ1OApSV1JZVkMvOS91czJDRjcyZlovSUJ0b1pXLzZMdWNxTnYxQjE1aUt5UHIrSm1JSUhpQkRZL0FaWgo=",
      "endpoints": [
        "https://mimir-updates.s3.eu-north-1.amazonaws.com/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
