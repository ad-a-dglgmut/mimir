{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mimir",
  "version": "0.1.0",
  "identifier": "com.pavel.mimir",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mimir_v2",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "keys/tauri.pub",
      "python/**/*"
    ]
  },
  "tauri": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://mimir-updates.s3.eu-north-1.amazonaws.com/latest.json"
      ],
      "dialog": true,
      "pubkey": "keys/tauri.pub"
    }
  }
}
